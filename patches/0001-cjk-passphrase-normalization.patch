+# BIP39 requires the passphrase to be NFKD-normalized before it is used as the
+# PBKDF2 salt, but a number of wallets never normalized what the user typed and
+# hashed it as-is. This only ever matters for non-ASCII passphrases: for Hangul,
+# Kana, and other scripts NFC and NFKD are different byte strings, so they derive
+# completely different seeds. Trying each form makes those wallets recoverable
+# when the passphrase itself is already known to be correct.
+PASSPHRASE_NORMALIZATION_FORMS = ("NFKD", "NFC", "NFD", "NFKC")
+
+# The forms actually tried, in order; set from --passphrase-normalizations in main().
+# The default matches the BIP39 spec, and so preserves the historical behaviour.
+passphrase_normalizations = ("NFKD",)
+
+def parse_passphrase_normalizations(spec):
+    """Parse a --passphrase-normalizations value into an ordered, deduplicated tuple of forms."""
+    if not spec:
+        return ("NFKD",)
+    if spec.strip().lower() == "all":
+        return PASSPHRASE_NORMALIZATION_FORMS
+    forms = []
+    for raw in spec.split(","):
+        form = raw.strip().upper()
+        if not form:
+            continue
+        if form not in PASSPHRASE_NORMALIZATION_FORMS:
+            raise ValueError("unknown Unicode normalization form '{}'; choose from {} or 'all'"
+                             .format(raw.strip(), ", ".join(PASSPHRASE_NORMALIZATION_FORMS)))
+        if form not in forms:
+            forms.append(form)
+    if not forms:
+        raise ValueError("--passphrase-normalizations requires at least one form")
+    # NFKD is what BIP39 specifies, so try it first whenever it was requested
+    forms.sort(key=lambda f: f != "NFKD")
+    return tuple(forms)
