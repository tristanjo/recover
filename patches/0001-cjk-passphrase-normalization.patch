+    # Maps each derivation salt to the normalization form it was produced from, so a
+    # match can say which one hit. Subclasses that build _derivation_salts themselves
+    # (e.g. WalletAezeed) simply leave this empty and get the plain passphrase back.
+    _derivation_salt_forms = {}
+
+    def _describe_salt(self, salt):
+        """Render a derivation salt for display, noting which normalization form produced it.
+
+        NFC and NFD render identically on screen, so the form is the only way to tell a
+        recovered passphrase apart from the one the user already typed in."""
+        if salt not in self._derivation_salt_forms:
+            for prefix in (b"mnemonic", b"electrum"):  # _verify_seed() is also called with the salt prefixed
+                if salt.startswith(prefix) and salt[len(prefix):] in self._derivation_salt_forms:
+                    salt = salt[len(prefix):]
+                    break
+        text = salt.decode("utf-8", "replace")
+        form = self._derivation_salt_forms.get(salt)
+        return "{} [{}]".format(text, form) if form else text
+
